# Copiar este archivo a ".env.local" (ignorado por Git) y completar con los valores del proyecto Firebase "App-Dev-Pilares".
# Origen: Firebase Console > Configuración del proyecto > Tus apps > App web (o .env.example de la app móvil).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
